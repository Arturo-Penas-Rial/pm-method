# Auto detect text files and perform LF normalization
* text=auto
# Scripts y hooks siempre con LF (en Windows, CRLF rompe sh y python en Git Bash)
*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf
# pm-kb: lanzador sin extensión, SQL y Dockerfile de la base con LF en cualquier sistema
pm-kb/pm-kb text eol=lf
*.sql text eol=lf
*.Dockerfile text eol=lf
